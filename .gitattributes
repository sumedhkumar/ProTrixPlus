# Normalize line endings. Keep everything LF in the repo; shell scripts and
# Dockerfiles MUST stay LF to run inside Linux containers.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.mako text eol=lf

*.png binary
*.ico binary
