# Copy to infra/.env and adjust ports if they clash. SAFE PLACEHOLDERS ONLY.
# Nothing here is a real secret. Never put a real credential in this repo.

# ---- host port mappings ----
PROTRIX_POSTGRES_PORT=5432
PROTRIX_REDIS_PORT=6379
PROTRIX_API_PORT=8000
PROTRIX_WORKER_HEALTH_PORT=8100
PROTRIX_WEB_PORT=3000

# ---- mock dev identity (HS256 shared secret) ----
# Placeholder. The api refuses to start in prod with dev identity enabled.
PROTRIX_DEV_JWT_SECRET=dev-only-not-a-real-secret-change-me
PROTRIX_DEV_JWT_ISSUER=protrixplus-dev-identity

# ---- mock webhook ingress auth (stands in for a signed TradingView source) ----
PROTRIX_WEBHOOK_SHARED_SECRET=dev-webhook-token-change-me
# Direct TradingView route secret. Put this in the alert URL path; never commit
# the real value. Example: https://your-public-host/webhook/tradingview/<secret>
PROTRIX_TRADINGVIEW_WEBHOOK_SECRET=

# ---- app ----
PROTRIX_APP_ENV=local
PROTRIX_LOG_LEVEL=INFO
PROTRIX_EXECUTION_ADAPTER=mock

# ---- email (Gmail SMTP) ----
# "mock" (default) only logs to/subject and never sends real mail - safe for
# local dev/CI. Set to "smtp" + fill in real values to send for real. Gmail
# needs an App Password (2FA account), not the account login password:
# https://myaccount.google.com/apppasswords
PROTRIX_EMAIL_BACKEND=mock
PROTRIX_SMTP_HOST=smtp.gmail.com
PROTRIX_SMTP_PORT=587
PROTRIX_SMTP_USERNAME=protrixplus@gmail.com
PROTRIX_SMTP_PASSWORD=
PROTRIX_SMTP_FROM_NAME=ProTrixPlus
PROTRIX_SMTP_FROM_ADDRESS=protrixplus@gmail.com
# "brevo" sends over HTTPS (api.brevo.com) instead of SMTP, and is what
# production runs: Render blocks outbound ports 25/465/587 on free web
# services. Free tier is 300/day; the from-address above must be verified
# under Senders in the Brevo dashboard or sends are rejected.
PROTRIX_BREVO_API_KEY=
# Where payment-proof (UTR) submissions get emailed for admin review.
PROTRIX_ADMIN_NOTIFY_EMAIL=protrixplus@gmail.com
# Used to build the password-reset link sent to a user's inbox.
PROTRIX_FRONTEND_BASE_URL=http://localhost:3000

# ---- manual payment instructions (shown on /subscribe) ----
# All optional. Leave blank to show a "to be added" placeholder on the
# subscribe page instead of real payment details.
PROTRIX_PAYMENT_BANK_ACCOUNT_NAME=
PROTRIX_PAYMENT_BANK_ACCOUNT_NUMBER=
PROTRIX_PAYMENT_BANK_IFSC=
PROTRIX_PAYMENT_BANK_NAME=
PROTRIX_PAYMENT_UPI_ID=
# URL to an uploaded QR code image (e.g. a UPI QR code).
PROTRIX_PAYMENT_QR_CODE_URL=

# ---- native Windows MT5 adapter (demo only; never commit real values) ----
# The worker remains mock-only until PROTRIX_EXECUTION_ADAPTER=mt5.
PROTRIX_MT5_USER_EMAIL=alice@example.test
PROTRIX_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
PROTRIX_MT5_LOGIN=0
PROTRIX_MT5_PASSWORD=
PROTRIX_MT5_SERVER=
PROTRIX_MT5_SYMBOL=XAUUSD
PROTRIX_MT5_TRADING_ENABLED=false
PROTRIX_MT5_MAGIC=260909
PROTRIX_MT5_DEVIATION_POINTS=20
PROTRIX_MT5_TIMEOUT_SECONDS=30
